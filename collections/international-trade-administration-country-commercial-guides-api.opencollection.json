              },
              {
                "name": "countries",
                "value": "",
                "type": "query",
                "description": "Comma-separated ISO country codes."
              },
              {
                "name": "industries",
                "value": "",
                "type": "query",
                "description": "Comma-separated industry filter."
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "subscription-key",
              "value": "{{subscription-key}}",
              "placement": "header"
            }
          },
          "docs": "Search Country Commercial Guide chapters published by U.S. commercial service officers covering market conditions and opportunities."
        }
      ]
    }
  ],
